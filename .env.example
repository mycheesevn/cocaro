# Caro (Cờ Ca-rô) — environment variables.
# Copy to .env.local for local development. Production values live in Vercel.

# Canonical site URL
NEXT_PUBLIC_SITE_URL=https://cocaro.synerworlds.com

# Supabase (shared family project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (VAPID) — public key is hardcoded as fallback; private key is server-only
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Google Analytics 4 (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Shared-cookie SSO family domain
NEXT_PUBLIC_FAMILY_COOKIE_DOMAIN=.synerworlds.com
